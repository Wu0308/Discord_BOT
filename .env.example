# Discord Bot Token (必要)
# 從 https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=你的機器人TOKEN

# 應用程式 ID (必要，用於註冊斜線指令)
# 從 Discord Developer Portal → General Information → Application ID
CLIENT_ID=你的應用程式ID

# 伺服器 ID (選用)
# 如果設定，斜線指令只會註冊到這個伺服器，開發時立即生效
# GUILD_ID=你的伺服器ID

# YouTube Data API v3 Key (選用，用於更穩定的 YouTube 搜尋)
# YOUTUBE_API_KEY=你的YouTube API金鑰

# 前綴指令符號 (選用，預設 !)
PREFIX=!

# 機器人狀態訊息
STATUS_MESSAGE=🎵 輸入 /play 聽音樂！
